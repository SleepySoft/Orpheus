{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orpheus Project",
  "type": "object",
  "required": ["version", "graph"],
  "properties": {
    "version": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "sample_rate": { "type": "integer", "default": 48000 },
    "block_size": { "type": "integer", "default": 128 },
    "buffer_size": { "type": "integer", "default": 0 },
    "double_bank": {
      "type": "string",
      "enum": ["auto", "on", "off"],
      "default": "auto",
      "description": "BULK 双 bank：auto=按组件声明 / on=全部开启 / off=关闭（直写即时生效，部署内存紧张时用）"
    },
    "target": {
      "type": "string",
      "enum": ["auto", "win", "dsp"],
      "default": "auto",
      "description": "期望目标平台：auto 自动判定 / win（Windows PC）/ dsp（通用 DSP）"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sample_rate": { "type": "integer" },
          "block_size": { "type": "integer" },
          "priority": { "type": "integer" }
        }
      }
    },
    "graph": { "$ref": "#/definitions/graph" },
    "control_connections": {
      "type": "array",
      "description": "控制连接：源节点可读参数 → 目标节点 bindable 参数（from/to 均为 node:param）",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "description": "node:param，源参数须声明 control_source" },
          "to": { "type": "string", "description": "node:param，目标参数须声明 bindable" }
        }
      }
    },
    "subcomponents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "graph"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "direction", "maps_to"],
              "properties": {
                "id": { "type": "string" },
                "direction": { "enum": ["input", "output"] },
                "maps_to": { "type": "string" }
              }
            }
          },
          "public_parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "direction", "maps_to"],
              "properties": {
                "id": { "type": "string" },
                "direction": { "enum": ["input", "output"] },
                "maps_to": { "type": "string" },
                "name": { "type": "string" },
                "type": { "enum": ["float", "int", "bool", "string"] },
                "default": {},
                "shape": { "type": "array", "items": { "type": ["integer", "string"] } },
                "update_policy": {
                  "enum": ["immediate", "block_boundary", "smoothed", "transactional", "restart_required"]
                }
              }
            }
          },
          "graph": { "$ref": "#/definitions/graph" }
        }
      }
    }
  },
  "definitions": {
    "graph": {
      "type": "object",
      "required": ["nodes", "connections"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "component"],
            "properties": {
              "id": { "type": "string" },
              "component": { "type": "string" },
              "label": { "type": "string", "description": "节点显示名（可重命名，空=用 id 显示）" },
              "version": { "type": "string" },
              "task": { "type": "string" },
              "params": { "type": "object" },
              "alters": {
                "type": "array",
                "items": { "type": "string" },
                "description": "用户声明的替代组：本节点与同图内这些节点二选一（按目标平台解析）"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
