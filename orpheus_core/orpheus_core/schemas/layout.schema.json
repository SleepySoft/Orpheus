{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orpheus Canvas Layout",
  "type": "object",
  "required": ["version", "views"],
  "properties": {
    "version": { "const": 1 },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": { "$ref": "#/definitions/positions" },
          "bridges": { "$ref": "#/definitions/positions" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "positions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  }
}
