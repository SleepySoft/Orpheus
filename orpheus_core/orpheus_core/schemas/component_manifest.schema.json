{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orpheus Component Manifest",
  "type": "object",
  "required": ["id", "version", "abi_version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
    "name": { "type": "string", "description": "Human-readable display name (UI palette)" },
    "category": { "type": "string", "description": "Palette category path, '/'-separated levels, e.g. 基础/滤波 or 高级/频域" },
    "order": { "type": "integer", "description": "叶内排序权重（小的在前，缺省按名字排）；用于基础桶的教学顺序" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "abi_version": { "type": "integer", "minimum": 1 },
    "package_type": { "type": "string", "enum": ["source", "binary", "composite"], "default": "source" },
    "user_owned": {
      "type": "boolean",
      "default": false,
      "description": "用户自定义组件（脚手架创建）：可从 UI 删除（需确认）或提升为公共库（提升后不可直接删除）"
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string" },
      "description": "平台限制标签（缺省=无指定平台，可移植、任何平台可用）；如 [win] / [dsp]"
    },
    "codegen_template": {
      "type": "string",
      "description": "execution.none 组件的代码生成模板（如 platform_hooks / uart_link）；缺省按组件 id 回退，未匹配则跳过代码生成"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "依赖：第三方（miniaudio）或组件 id（如 orpheus.builtin.biquad），生成工程递归复制"
    },
    "headers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "compiler", "artifact"],
        "properties": {
          "platform": { "type": "string" },
          "compiler": { "type": "string" },
          "artifact": { "type": "string" }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "direction", "type"],
        "properties": {
          "id": { "type": "string" },
          "direction": { "type": "string", "enum": ["input", "output"] },
          "type": { "type": "string", "enum": ["audio", "control", "bulk", "debug"] },
          "sample_format": { "type": "string", "enum": ["f32", "i16", "i24", "i32"] },
          "channels": { "type": ["integer", "string"] },
          "sample_rate": { "type": ["integer", "string"] },
          "block_size": { "type": ["integer", "string"] },
          "count": { "type": ["integer", "string"], "description": "Variable pin count expression, e.g. param:channels; port is replicated as <id>0..<id>N-1" },
          "is_variable": { "type": "boolean" },
          "channels_param": { "type": "string" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["float", "int", "bool", "string"] },
          "default": {},
          "range": { "type": "array", "minItems": 2, "maxItems": 2 },
          "unit": { "type": "string" },
          "widget": { "type": "string", "enum": ["number", "text", "slider", "select", "checkbox", "file"], "description": "UI control hint; default inferred from type" },
          "file_ext": { "type": "string", "description": "Extension filter for the file widget, e.g. .mp3" },
          "options": { "type": "array", "description": "Static options for select widget: [{value,label}] or scalars" },
          "options_source": { "type": "string", "enum": ["devices"], "description": "Dynamic options provider" },
          "readonly": { "type": "boolean", "description": "Display-only parameter" },
          "update_policy": { "type": "string", "enum": ["immediate", "block_boundary", "smoothed", "transactional", "restart_required"] },
          "readback": { "type": "boolean" },
          "persistent": { "type": "boolean" },
          "affects_signature": { "type": "boolean" },
          "kind": {
            "type": "string",
            "enum": ["setting", "command", "bulk", "probe", "state"],
            "description": "数据点类别：调音参数 / 一次性命令 / 大块数据(Bulk) / 探针 / 内部状态。缺省按 readback+persistent 推断（探针），否则为 setting。UI 参数面板据此分类组织。"
          }
        }
      }
    },
    "clock_source": { "type": "boolean", "description": "This component binds the graph to an external clock (device/file/timer)" },
    "clock_domain": { "type": "string", "description": "Clock domain id, e.g. device/file; equal domains are compatible" },
    "scheduling": {
      "type": "object",
      "properties": {
        "divisor": { "type": ["integer", "string"], "description": "Rate divisor expression for the OUTPUT domain, e.g. param:factor" }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "state_size": { "type": "integer" },
        "scratch_size": { "type": "integer" },
        "alignment": { "type": "integer" }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "none": {
          "type": "boolean",
          "default": false,
          "description": "声明式平台节点（如 platform_hook）：不参与运行时执行，仅代码生成，供用户程序引用"
        },
        "sample_rate_independent": { "type": "boolean" },
        "latency_samples": { "type": "integer" },
        "supports_inplace": { "type": "boolean" },
        "realtime_safe": { "type": "boolean" }
      }
    },
    "graph": { "type": "object" },
    "public_ports": { "type": "array" },
    "public_parameters": { "type": "array" },
    "custom_handles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "reply"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "reply": {
            "type": "boolean",
            "description": "true=response（同步返回内容）；false=notification（单向消息）"
          }
        }
      },
      "description": "CUSTOM 类消息入口声明（进 id_map，供二进制 MSG 协议路由到组件 hook；用户完全自处理）。"
    },
    "bulk_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "count"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["float", "int", "bool", "string"] },
          "count": { "type": "integer", "minimum": 1 },
          "unit": { "type": "string" }
        }
      },
      "description": "运行期 BULK 槽声明：组件 register_slots 注册的数组槽（如 biquad_bank 系数），供参数面板展示并在实时会话中写入（BULK 协议），不随工程保存。"
    }
  }
}
