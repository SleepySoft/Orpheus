{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orpheus.local/schemas/component_interface.schema.json",
  "title": "Orpheus 独立组件接口声明（ABI v7）",
  "description": "唯一配置事实源。重复键、引用、范围默认值与驱动编号唯一性由 Python 共享校验核心补充验证。",
  "type": "object",
  "required": ["id", "name", "version", "interfaces"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:[.-][A-Za-z0-9_]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "clock_domain": {"type": "string", "minLength": 1},
    "abi_version": {"const": 7},
    "package_type": {"const": "source"},
    "clock_source": {"type": "boolean"},
    "order": {"type": "integer"},
    "ui_hidden": {"type": "boolean"},
    "user_owned": {"type": "boolean"},
    "platforms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_alternatives": {
      "type": "array", "uniqueItems": true,
      "description": "每组单个输入数据接口恰好连接一个；引用及跨组不交叠由共享校验核心验证。",
      "items": {
        "type": "array", "minItems": 2, "uniqueItems": true,
        "items": {"$ref": "#/$defs/identifier"}
      }
    },
    "scheduling": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "history": {"type": "boolean"}, "split": {"type": "boolean"}, "merge": {"type": "boolean"},
        "async_bridge": {"type": "boolean"},
        "divisor": {"$ref": "#/$defs/scheduling_value"},
        "input_block_size": {"$ref": "#/$defs/scheduling_value"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "none": {"type": "boolean"},
        "sample_rate_independent": {"type": "boolean"},
        "latency_samples": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "supports_inplace": {"type": "boolean"},
        "realtime_safe": {"type": "boolean"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "state_size": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "scratch_size": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "alignment": {"type": "integer", "minimum": 1, "maximum": 4294967294}
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {"$ref": "#/$defs/identifier"},
        "state_type": {"$ref": "#/$defs/identifier"},
        "io_type": {"$ref": "#/$defs/identifier"},
        "private_type": {"$ref": "#/$defs/identifier"},
        "function": {"$ref": "#/$defs/identifier"},
        "lifecycle": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["normalize", "validate", "prepare", "reset", "destroy", "set_parameter", "get_parameter", "register_slots", "hook"]}
        }
      }
    },
    "interfaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/port"},
          {"$ref": "#/$defs/parameter"}
        ]
      }
    }
  },
  "$defs": {
    "scheduling_value": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(?:[1-9][0-9]*|param:[A-Za-z][A-Za-z0-9_]*)(?:\\s*\\*\\s*(?:[1-9][0-9]*|param:[A-Za-z][A-Za-z0-9_]*))*$"}
      ]
    },
    "bulk_binding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sample_format": {"enum": ["f32", "i32", "bool"]},
        "slot_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$", "not": {"pattern": "\\s"}},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 65536},
        "storage": {"type": "string", "pattern": "^algorithm(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
        "double_bank": {"type": "boolean"},
        "auto_register": {"type": "boolean", "default": true},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38}}
      }
    },
    "host_binding": {
      "type": "object",
      "required": ["slot", "access", "status"],
      "additionalProperties": false,
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "access": {"enum": ["write", "read"]},
        "status": {"$ref": "#/$defs/identifier"},
        "when": {"type": "object", "additionalProperties": {"type": ["integer", "boolean", "string", "number"]}}
      },
      "description": "引用外部BULK资源键及bool交付状态；when仅引用重启生效的标量配置，独立工具与编译器共用静态契约校验。"
    },
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 4294967294},
    "signature": {
      "oneOf": [
        {"$ref": "#/$defs/positive"},
        {"type": "string", "pattern": "^(param:[A-Za-z][A-Za-z0-9_]*|task:(block_size|sample_rate)|(?!task:)[A-Za-z][A-Za-z0-9_]*:(channels|block_size|sample_rate))$"}
      ]
    },
    "product": {
      "type": "string",
      "pattern": "^(param:[A-Za-z][A-Za-z0-9_]*|[1-9][0-9]*)(\\*(param:[A-Za-z][A-Za-z0-9_]*|[1-9][0-9]*))+$(?![\\s\\S])"
    },
    "channels": {
      "description": "保留既有通道签名；正整数/param 引用乘法复用签名乘积语法，新通道乘积在声明范围内不得超过 65536。",
      "oneOf": [
        {"$ref": "#/$defs/signature"},
        {"$ref": "#/$defs/product"}
      ]
    },
    "payload": {
      "description": "块载荷可用无空白的正整数/param 引用乘法链。所有显式 audio 块长均为独立载荷；task 引用固定为准备配置值，仅未声明块长的 audio 继承 ctx 实际量子。",
      "oneOf": [
        {"$ref": "#/$defs/signature"},
        {"$ref": "#/$defs/product"}
      ]
    },
    "port": {
      "type": "object",
      "required": ["type", "direction"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "direction": {"enum": ["input", "output"]},
        "type": {"enum": ["audio", "control", "bulk", "debug", "trigger"]},
        "sample_format": {"enum": ["f32", "i16", "i24", "i32"]},
        "channels": {"$ref": "#/$defs/channels"},
        "block_size": {"$ref": "#/$defs/payload"},
        "sample_rate": {"$ref": "#/$defs/signature"},
        "count": {"oneOf": [
          {"type": "integer", "minimum": 0, "maximum": 4294967294},
          {"type": "string", "pattern": "^param:[A-Za-z][A-Za-z0-9_]*$"}
        ]},
        "process": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "host_binding": {"$ref": "#/$defs/host_binding"},
        "timing": {"enum": ["sync", "latest"]},
        "allow_unready": {
          "type": "boolean",
          "description": "仅用于非驱动 latest BULK 输入；允许有效长度为零，算法读取前须自行确认完整 payload 就绪。"
        },
        "layout": {"type": "string", "description": "非音频布局标签；halfcomplex 仅允许带正 frame_size 的显式 f32 BULK 载荷。"},
        "frame_size": {"oneOf": [
          {"type": "integer", "minimum": 0, "maximum": 4294967294},
          {"type": "string", "pattern": "^param:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"}
        ]},
        "drive_port_no": {"$ref": "#/$defs/positive"},
        "drive_divide": {
          "$ref": "#/$defs/positive",
          "description": "仅可视化注记，不影响调度、帧数或 Delivery 时间元数据。"
        }
      },
      "allOf": [
        {"if": {"required": ["host_binding"]}, "then": {
          "properties": {"type": {"const": "audio"}, "sample_format": {"const": "f32"}}
        }},
        {"if": {"required": ["layout"], "properties": {"layout": {"const": "halfcomplex"}}}, "then": {
          "required": ["block_size", "frame_size"],
          "properties": {"type": {"const": "bulk"}, "sample_format": {"const": "f32"},
                         "frame_size": {"not": {"const": 0}}}
        }},
        {"if": {"required": ["allow_unready"]}, "then": {
          "required": ["timing"],
          "properties": {"type": {"const": "bulk"}, "direction": {"const": "input"},
                         "timing": {"const": "latest"}, "process": {"const": false}}
        }},
        {"if": {"required": ["count"], "properties": {"count": {"const": 0}}}, "then": {
          "required": ["optional"], "properties": {"optional": {"const": true}}
        }},
        {"if": {"required": ["drive_port_no"]}, "then": {"properties": {"direction": {"const": "output"}}}},
        {"if": {"required": ["drive_divide"]}, "then": {"required": ["drive_port_no"]}},
        {"if": {"required": ["process"], "properties": {"process": {"const": true}}}, "then": {"properties": {"direction": {"const": "input"}}}},
        {"if": {"properties": {"type": {"const": "audio"}}}, "then": {"not": {"anyOf": [{"required": ["layout"]}, {"required": ["frame_size"]}]}}},
        {"if": {"required": ["timing"], "properties": {"timing": {"const": "latest"}}}, "then": {"properties": {"type": {"enum": ["control", "bulk", "debug"]}, "direction": {"const": "input"}, "process": {"const": false}}}},
        {"if": {"properties": {"type": {"const": "trigger"}}}, "then": {
          "not": {"anyOf": [
            {"required": ["sample_format"]}, {"required": ["channels"]}, {"required": ["sample_rate"]},
            {"required": ["block_size"]}, {"required": ["layout"]},
            {"required": ["frame_size"]}, {"required": ["timing"]}
          ]},
          "allOf": [
            {"if": {"properties": {"direction": {"const": "output"}}}, "then": {"required": ["drive_port_no"]}}
          ]
        }}
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "type": {"enum": ["float", "int", "bool", "string"]},
        "default": {"description": "仅显式 kind:probe 且 access:read 可省略：按类型初始化零值，定长数值数组展开为 count 个零；显式值仍须完整声明。"},
        "range": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number"}
        },
        "update_policy": {"enum": ["immediate", "block_boundary", "smoothed", "transactional", "restart_required"]},
        "affects_signature": {"type": "boolean"},
        "readback": {"type": "boolean"},
        "persistent": {"type": "boolean"},
        "unit": {"type": "string"},
        "count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "bulk": {"$ref": "#/$defs/bulk_binding"},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 65536, "description": "UTF-8 字节容量，包含末尾 NUL；默认 256"},
        "shape": {
          "type": "array",
          "items": {"oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^(?:param:[A-Za-z][A-Za-z0-9_]*|config:frames)$"}
          ]}
        },
        "bindable": {"type": "boolean"},
        "control_source": {"type": "boolean"},
        "kind": {"enum": ["setting", "command", "bulk", "probe", "state"]},
        "access": {"enum": ["read", "write", "read_write"]},
        "readonly": {"type": "boolean"},
        "widget": {"enum": ["number", "text", "slider", "select", "checkbox", "file", "placeholder_ports"]},
        "file_ext": {"type": "string"},
        "bulk_slot": {"type": "string"},
        "options_source": {"const": "devices"},
        "options": {
          "type": "array",
          "items": {"oneOf": [
            {"type": ["string", "number", "boolean"]},
            {"type": "object", "required": ["value", "label"], "additionalProperties": false,
             "properties": {"value": {"type": ["string", "number", "boolean"]}, "label": {"type": "string"}}}
          ]}
        }
      },
      "allOf": [
        {"if": {"required": ["kind", "access"], "properties": {
          "kind": {"const": "probe"}, "access": {"const": "read"}
        }}, "else": {"required": ["default"]}},
        {"if": {"properties": {"type": {"const": "float"}}}, "then": {"properties": {"default": {"oneOf": [
          {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
          {"type": "array", "items": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38}}
        ]}, "range": {"items": {
          "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38}}}}},
        {"if": {"properties": {"type": {"const": "int"}}}, "then": {"properties": {"default": {"oneOf": [
          {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
          {"type": "array", "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}
        ]}, "range": {"items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}}}},
        {"if": {"properties": {"type": {"const": "bool"}}}, "then": {"not": {"required": ["range"]}, "properties": {"default": {"oneOf": [
          {"type": "boolean"}, {"type": "array", "items": {"type": "boolean"}}
        ]}}}},
        {"if": {"properties": {"type": {"const": "string"}}}, "then": {"not": {"required": ["range"]}, "properties": {"default": {"type": "string"}}}},
        {"if": {"required": ["affects_signature"], "properties": {"affects_signature": {"const": true}}}, "then": {"required": ["update_policy"], "properties": {"update_policy": {"const": "restart_required"}}}},
        {"if": {"required": ["capacity"]}, "then": {"properties": {"type": {"const": "string"}}}},
        {"if": {"required": ["count"], "properties": {"type": {"enum": ["float", "int", "bool"]}}}, "then": {
          "properties": {"default": {"type": "array"}, "affects_signature": {"const": false},
            "kind": {"enum": ["bulk", "probe", "state"]}}
        }, "else": {"properties": {"default": {"not": {"type": "array"}}}}},
        {"if": {"required": ["bulk"]}, "then": {
          "allOf": [
            {"if": {"properties": {"type": {"const": "string"}}}, "then": {
              "properties": {"kind": {"const": "bulk"}, "bulk": {"required": ["sample_format", "capacity", "storage"]}}
            }, "else": {
              "required": ["count"], "properties": {"count": {"minimum": 1},
                "bulk": {"properties": {"storage": false, "capacity": false, "range": false}}}
            }},
            {"if": {"properties": {"type": {"const": "float"}}}, "then": {"properties": {"bulk": {"properties": {"sample_format": {"const": "f32"}}}}}},
            {"if": {"properties": {"type": {"const": "int"}}}, "then": {"properties": {"bulk": {"properties": {"sample_format": {"const": "i32"}}}}}},
            {"if": {"properties": {"type": {"const": "bool"}}}, "then": {"properties": {"bulk": {"properties": {"sample_format": {"const": "bool"}, "range": false}}}}}
          ]
        }},
        {"if": {"required": ["bindable"], "properties": {"bindable": {"const": true}}}, "then": {"properties": {
          "affects_signature": {"const": false}, "update_policy": {"enum": ["immediate", "block_boundary", "smoothed"]},
          "readonly": {"const": false}, "access": {"enum": ["write", "read_write"]},
          "kind": {"enum": ["setting", "command", "bulk"]}
        }}}
      ]
    }
  }
}
